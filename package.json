{
  "name": "suitora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./src/**/*.ts tsconfig.json --max-warnings=0",
    "lint:fix": "eslint ./src/**/*.ts --fix",
    "lint:md": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"ARCHITECTURE.md\" \"SECURITY.md\" \"docs/README.md\" \"docs/runbooks.md\" \"docs/runbooks/**\" \"runbooks/**/*.md\"",
    "check:links": "markdown-link-check -c .markdown-link-check.json \"README.md\" \"CONTRIBUTING.md\" \"ARCHITECTURE.md\" \"SECURITY.md\" \"docs/README.md\" \"docs/runbooks.md\" \"runbooks/database-backup.md\" \"runbooks/service-restart.md\" \"runbooks/crash-alert.md\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "sync:trend": "tsx --env-file=.env.local jobs/trend-sync.ts",
    "worker": "tsx services/worker/index.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:rollback": "node scripts/migrate.mjs --down",
    "db:status": "node scripts/migrate.mjs --status",
    "backup": "tsx jobs/backup.ts",
    "restore": "tsx jobs/restore.ts",
    "prepare": "husky install",
    "analyze": "BUNDLE_ANALYZE=true next build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@better-auth/infra": "^0.3.6",
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/cli": "^4.3.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.6.23",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "headroom-ai": "^0.22.4",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pino": "^10.3.1",
    "pino-std-serializers": "^7.1.0",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "swr": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pino": "^7.0.4",
    "@types/pino-std-serializers": "^2.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "cypress": "^15.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-drizzle": "^0.2.3",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.3.2",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vite": "^5.4.8",
    "vitest": "^4.1.10"
  }
}
